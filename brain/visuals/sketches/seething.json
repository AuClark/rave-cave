{
  "title": "Seething",
  "about": "A lumpy ball of living cells, after Andy Lomas's video for Max Cooper's Seething. Cells jitter, Folds carves brain-like creases, it breathes on the kick and grows through the section.",
  "groups": [
    {"name": "Mass", "params": [
      {"id": "size",    "label": "Size",                 "min": 0.1,  "max": 1.2,  "step": 0.01,  "default": 0.36},
      {"id": "grow",    "label": "Grow through section", "min": 0,    "max": 1,    "step": 0.01,  "default": 0.4},
      {"id": "lumps",   "label": "Lumps",                "min": 0,    "max": 1.5,  "step": 0.01,  "default": 0.8},
      {"id": "beat",    "label": "Beat punch",           "min": 0,    "max": 1,    "step": 0.01,  "default": 0.5}
    ]},
    {"name": "Cells", "params": [
      {"id": "density", "label": "Cells across",         "min": 2,    "max": 40,   "step": 0.5,   "default": 6},
      {"id": "jitter",  "label": "Jitter",               "min": 0,    "max": 1,    "step": 0.01,  "default": 0.6},
      {"id": "cspeed",  "label": "Seethe speed",         "min": 0,    "max": 2,    "step": 0.01,  "default": 0.5},
      {"id": "folds",   "label": "Folds",                "min": 0,    "max": 1,    "step": 0.01,  "default": 0},
      {"id": "fscale",  "label": "Fold size",            "min": 1,    "max": 12,   "step": 0.1,   "default": 5}
    ]},
    {"name": "Look", "params": [
      {"id": "shade",   "label": "Shading",              "min": 0,    "max": 1,    "step": 0.01,  "default": 0.9},
      {"id": "bg",      "label": "Background",           "min": 0,    "max": 1,    "step": 0.01,  "default": 0},
      {"id": "hue",     "label": "Hue",                  "min": 0,    "max": 1,    "step": 0.005, "default": 0.0},
      {"id": "spread",  "label": "Hue spread",           "min": 0,    "max": 1,    "step": 0.01,  "default": 0.2},
      {"id": "sat",     "label": "Saturation",           "min": 0,    "max": 1,    "step": 0.01,  "default": 0.8},
      {"id": "follow",  "label": "Follow show hue",      "min": 0,    "max": 1,    "step": 1,     "default": 0}
    ]}
  ]
}
