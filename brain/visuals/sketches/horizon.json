      {"id": "chromatic", "label": "Chromatic (spectral rings)",  "min": 0,   "max": 1,   "step": 0.01, "default": 0},
      {"id": "ring",      "label": "Photon ring fringe",          "min": 0,   "max": 3,   "step": 0.01, "default": 1},
      {"id": "stars",     "label": "Stars",                       "min": 0,   "max": 3,   "step": 0.01, "default": 1}
    ]},
