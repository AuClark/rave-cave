{
  "title": "Sequin Wave",
  "about": "Thousands of tiny mirror sequins on a hex grid, tilted by interfering waves and flashing gold as they catch the light (after Radiant's Sequin Wave by Paul Bakaus). The kick makes them sparkle, a ring of flashes runs out from the centre on each beat, and a second light can circle the surface.",
  "groups": [
    {"name": "Sequins", "params": [
      {"id": "density",   "label": "Sequins across",         "min": 10,   "max": 90,   "step": 1,     "default": 38},
      {"id": "speed",     "label": "Wave speed (per beat)",  "min": 0,    "max": 1.5,  "step": 0.01,  "default": 0.38},
      {"id": "tiltamt",   "label": "Tilt",                   "min": 0,    "max": 2,    "step": 0.01,  "default": 1},
      {"id": "sparkle",   "label": "Sparkle",                "min": 0,    "max": 3,    "step": 0.01,  "default": 1},
      {"id": "shimmer",   "label": "Individual shimmer",     "min": 0,    "max": 4,    "step": 0.01,  "default": 1}
    ]},
    {"name": "Beat", "params": [
      {"id": "punch",     "label": "Sparkle on kick",        "min": 0,    "max": 3,    "step": 0.01,  "default": 0.6},
      {"id": "ring",      "label": "Ring from the centre",   "min": 0,    "max": 1.5,  "step": 0.01,  "default": 0}
    ]},
    {"name": "Light", "params": [
      {"id": "roam",      "label": "Roaming light",          "min": 0,    "max": 2,    "step": 0.01,  "default": 0},
      {"id": "roamspeed", "label": "Roam (laps / 16 beats)", "min": 0,    "max": 4,    "step": 0.05,  "default": 1}
    ]},
    {"name": "Colour", "params": [
      {"id": "tint",      "label": "Original gold → tint",   "min": 0,    "max": 1,    "step": 0.01,  "default": 0},
      {"id": "hue",       "label": "Tint hue",               "min": 0,    "max": 1,    "step": 0.005, "default": 0.07},
      {"id": "sat",       "label": "Tint saturation",        "min": 0,    "max": 1,    "step": 0.01,  "default": 0.6},
      {"id": "bright",    "label": "Brightness",             "min": 0,    "max": 2,    "step": 0.01,  "default": 1},
      {"id": "vignette",  "label": "Vignette",               "min": 0,    "max": 1,    "step": 0.01,  "default": 1},
      {"id": "follow",    "label": "Follow show hue",        "min": 0,    "max": 1,    "step": 1,     "default": 0}
    ]}
  ]
}
