{
  "title": "Ascend",
  "about": "Energy climbing a pyramid face to the capstone: rising bands, glyph rows that light as the charge passes, running edges. Charges through the build, hits the apex on the drop. Triangle clips it to the face.",
  "groups": [
    {"name": "Face", "params": [
      {"id": "tri",    "label": "Triangle (clip to face)", "min": 0,   "max": 1,    "step": 1,     "default": 1},
      {"id": "edges",  "label": "Edge light",            "min": 0,     "max": 1,    "step": 0.01,  "default": 0.6},
      {"id": "apex",   "label": "Capstone glow",         "min": 0,     "max": 1,    "step": 0.01,  "default": 0.6}
    ]},
    {"name": "Charge", "params": [
      {"id": "level",  "label": "Charge level",          "min": 0,     "max": 1,    "step": 0.01,  "default": 0.15},
      {"id": "build",  "label": "Charges through build", "min": 0,     "max": 1,    "step": 0.01,  "default": 1},
      {"id": "drop",   "label": "Full on drop",          "min": 0,     "max": 1,    "step": 0.01,  "default": 1},
      {"id": "beat",   "label": "Beat punch",            "min": 0,     "max": 1,    "step": 0.01,  "default": 0.5}
    ]},
    {"name": "Bands", "params": [
      {"id": "bands",  "label": "Bands",                 "min": 0,     "max": 40,   "step": 1,     "default": 8},
      {"id": "speed", "kind": "rate",  "label": "Rise (cycles/beat)",    "min": -2,    "max": 2,    "step": 0.01,  "default": 0.25},
      {"id": "bwidth", "label": "Band width",            "min": 0.02,  "max": 0.9,  "step": 0.01,  "default": 0.12}
    ]},
    {"name": "Glyphs", "params": [
      {"id": "glyphs", "label": "Glyphs",                "min": 0,     "max": 1,    "step": 0.01,  "default": 0.7},
      {"id": "rows",   "label": "Rows",                  "min": 3,     "max": 40,   "step": 1,     "default": 14},
      {"id": "gspeed", "kind": "rate", "label": "Scroll (rows/beat)",    "min": -2,    "max": 2,    "step": 0.01,  "default": 0.125},
      {"id": "gwidth", "label": "Stroke",                "min": 0.02,  "max": 0.2,  "step": 0.005, "default": 0.08}
    ]},
    {"name": "Colour", "params": [
      {"id": "hue",    "label": "Hue",                   "min": 0,     "max": 1,    "step": 0.005, "default": 0.11},
      {"id": "spread", "label": "Glyph hue offset",      "min": 0,     "max": 1,    "step": 0.01,  "default": 0.4},
      {"id": "sat",    "label": "Saturation",            "min": 0,     "max": 1,    "step": 0.01,  "default": 0.8},
      {"id": "follow", "label": "Follow show hue",       "min": 0,     "max": 1,    "step": 1,     "default": 0}
    ]}
  ]
}
