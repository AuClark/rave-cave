{
  "title": "Eclipse Glow",
  "about": "A solar eclipse, played out: the moon crosses the sun over a cycle of beats, from a bite to a crescent, Baily's beads and the diamond ring, into totality with the corona and pink prominences, and back out (corona after Radiant's Eclipse Glow by Paul Bakaus). Set the phase by hand, or let it reach totality as each song section ends.",
  "climax": {"cycle": "cycle", "peak": "0.5 - hold / 2", "lock": "droplock", "what": "the diamond ring, then totality"},
  "groups": [
    {"name": "Eclipse", "params": [
      {"id": "cycle",   "label": "Crossing (beats, 0 = by hand)", "min": 0,   "max": 256, "step": 4,    "default": 64},
      {"id": "hold",    "label": "Totality (share of the cycle)", "min": 0,   "max": 0.9, "step": 0.01, "default": 0.3},
      {"id": "phase",   "label": "Phase by hand (0.5 = total)",   "min": 0,   "max": 1,   "step": 0.005,"default": 0.5},
      {"id": "section", "label": "Totality as the section ends",  "min": 0,   "max": 1,   "step": 1,    "default": 0},
      {"id": "path",    "label": "Moon's path (degrees)",         "min": -180,"max": 180, "step": 1,    "default": 15},
      {"id": "miss",    "label": "Miss (partial eclipse)",        "min": -1.5,"max": 1.5, "step": 0.01, "default": 0},
      {"id": "moon",    "label": "Moon size (< 1 annular)",       "min": 0.8, "max": 1.2, "step": 0.005,"default": 1.03},
      {"id": "size",    "label": "Size",                          "min": 0.3, "max": 3,   "step": 0.01, "default": 1}
    ]},
    {"name": "Sun", "params": [
      {"id": "sun",     "label": "Sun brightness",                "min": 0,   "max": 2,   "step": 0.01, "default": 1.1},
      {"id": "corona",  "label": "Corona size",                   "min": 0.2, "max": 2.5, "step": 0.01, "default": 1},
      {"id": "rays",    "label": "Ray intensity",                 "min": 0,   "max": 3,   "step": 0.01, "default": 1},
      {"id": "prom",    "label": "Prominences",                   "min": 0,   "max": 3,   "step": 0.01, "default": 1},
      {"id": "flare",   "label": "Lens streak",                   "min": 0,   "max": 5,   "step": 0.01, "default": 1},
      {"id": "stars",   "label": "Stars",                         "min": 0,   "max": 3,   "step": 0.01, "default": 1},
      {"id": "speed",   "label": "Corona time (per beat)",        "min": 0,   "max": 3,   "step": 0.01, "default": 0.476}
    ]},
    {"name": "Beat", "params": [
      {"id": "punch",   "label": "Corona and diamond on kick",    "min": 0,   "max": 2,   "step": 0.01, "default": 0.4},
      {"id": "diamond", "label": "Diamond ring",                  "min": 0,   "max": 3,   "step": 0.01, "default": 1},
      {"id": "droplock", "label": "Land the climax on the drop", "min": 0, "max": 1, "step": 1, "default": 1, "kind": "fixed"}
    ]},
    {"name": "Colour", "params": [
      {"id": "hue",     "label": "Hue shift",                     "min": 0,   "max": 1,   "step": 0.005,"default": 0},
      {"id": "follow",  "label": "Shift by show hue",             "min": 0,   "max": 1,   "step": 1,    "default": 0},
      {"id": "bright",  "label": "Brightness",                    "min": 0,   "max": 2,   "step": 0.01, "default": 1}
    ]}
  ]
}
