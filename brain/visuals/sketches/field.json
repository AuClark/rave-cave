{
  "title": "Field",
  "about": "A lattice of independent dots: they wander, drift across the surface, swell with a travelling wave and can link into a net.",
  "groups": [
    {"name": "Elements", "params": [
      {"id": "density", "label": "Density (dots across height)", "min": 2, "max": 60, "step": 1, "default": 14},
      {"id": "size",    "label": "Size",            "min": 0.02, "max": 1.2,  "step": 0.01,  "default": 0.35},
      {"id": "svar",    "label": "Size variation",  "min": 0,    "max": 1,    "step": 0.01,  "default": 0.3},
      {"id": "square",  "label": "Round → square",  "min": 0,    "max": 1,    "step": 0.01,  "default": 0},
      {"id": "ring",    "label": "Filled → outline","min": 0,    "max": 1,    "step": 0.01,  "default": 0}
    ]},
    {"name": "Movement", "params": [
      {"id": "wander",  "label": "Wander",          "min": 0,    "max": 1,    "step": 0.01,  "default": 0.45},
      {"id": "wspeed", "kind": "rate",  "label": "Wander speed (cycles/beat)", "min": 0, "max": 1, "step": 0.005, "default": 0.12},
      {"id": "flow",    "label": "Drift (cells/beat)", "min": -1, "max": 1,   "step": 0.01,  "default": 0.1},
      {"id": "angle",   "label": "Drift direction", "min": 0,    "max": 1,    "step": 0.005, "default": 0.0},
      {"id": "beat",    "label": "Beat punch",      "min": 0,    "max": 1,    "step": 0.01,  "default": 0.4}
    ]},
    {"name": "Wave", "params": [
      {"id": "wave",    "label": "Wave amount",     "min": 0,    "max": 1,    "step": 0.01,  "default": 0.7},
      {"id": "wfreq",   "label": "Wave frequency",  "min": 0,    "max": 6,    "step": 0.05,  "default": 1.5},
      {"id": "wspd", "kind": "rate",    "label": "Wave speed (cycles/beat)", "min": -1, "max": 1, "step": 0.01, "default": 0.25},
      {"id": "wangle",  "label": "Wave direction",  "min": 0,    "max": 1,    "step": 0.005, "default": 0.125}
    ]},
    {"name": "Links", "params": [
      {"id": "links",   "label": "Links",           "min": 0,    "max": 1,    "step": 0.01,  "default": 0},
      {"id": "lwidth",  "label": "Link width",      "min": 0.005,"max": 0.1,  "step": 0.001, "default": 0.02},
      {"id": "glow",    "label": "Glow",            "min": 0,    "max": 1,    "step": 0.01,  "default": 0.2}
    ]},
    {"name": "Colour", "params": [
      {"id": "hue",     "label": "Hue",             "min": 0,    "max": 1,    "step": 0.005, "default": 0.5},
      {"id": "spread",  "label": "Hue spread",      "min": 0,    "max": 1,    "step": 0.005, "default": 0.3},
      {"id": "huemode", "label": "Colour by: random → wave", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
      {"id": "sat",     "label": "Saturation",      "min": 0,    "max": 1,    "step": 0.01,  "default": 0.8},
      {"id": "follow",  "label": "Follow show hue", "min": 0,    "max": 1,    "step": 1,     "default": 1}
    ]}
  ]
}
