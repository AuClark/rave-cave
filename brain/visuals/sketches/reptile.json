{
  "title": "Reptile",
  "about": "Iridescent hex scales rippling on the beat, with a slit-pupil eye that opens wide on the drop.",
  "groups": [
    {"name": "Scales", "params": [
      {"id": "scale",  "label": "Scales across height",  "min": 3,     "max": 60,   "step": 0.5,   "default": 18},
      {"id": "gap",    "label": "Gap",                   "min": 0,     "max": 0.2,  "step": 0.005, "default": 0.04},
      {"id": "shine",  "label": "Shine",                 "min": 0,     "max": 1,    "step": 0.01,  "default": 0.5},
      {"id": "irid",   "label": "Iridescence",           "min": 0,     "max": 1,    "step": 0.01,  "default": 0.5},
      {"id": "wave",   "label": "Ripple",                "min": 0,     "max": 1,    "step": 0.01,  "default": 0.5},
      {"id": "wspeed", "kind": "rate", "label": "Ripple speed (cycles/beat)", "min": -2, "max": 2, "step": 0.01,  "default": 0.5},
      {"id": "beat",   "label": "Beat punch",            "min": 0,     "max": 1,    "step": 0.01,  "default": 0.5}
    ]},
    {"name": "Eye", "params": [
      {"id": "eye",    "label": "Eye",                   "min": 0,     "max": 1,    "step": 1,     "default": 1},
      {"id": "esize",  "label": "Eye size",              "min": 0.3,   "max": 3,    "step": 0.01,  "default": 1},
      {"id": "slit",   "label": "Slit width",            "min": 0.03,  "max": 0.6,  "step": 0.01,  "default": 0.12},
      {"id": "drop",   "label": "Opens on drop",         "min": 0,     "max": 1,    "step": 0.01,  "default": 1},
      {"id": "blink",  "label": "Blink",                 "min": 0,     "max": 1,    "step": 0.01,  "default": 0.3}
    ]},
    {"name": "Colour", "params": [
      {"id": "hue",    "label": "Hue",                   "min": 0,     "max": 1,    "step": 0.005, "default": 0.3},
      {"id": "sat",    "label": "Saturation",            "min": 0,     "max": 1,    "step": 0.01,  "default": 0.75},
      {"id": "follow", "label": "Follow show hue",       "min": 0,     "max": 1,    "step": 1,     "default": 0}
    ]}
  ]
}
