{
  "title": "Wormhole",
  "about": "Your own words (type them on the Visuals page, separated by |) running round the inside of an off-axis pipe you are falling down: a log-radius tunnel gives ring after ring of type with no end, and a Mobius transform puts the vanishing point off to one side. It is lit -- darkness gathering with depth, a light at the end, glowing type -- or, in Two tone, black type on card fading into haze. The kick lurches you down the pipe and fires a ring of light out of the hole (Hectic adds the streaks, split and bloom on the hits and the drop), the hats glint the seams, and the chords wander the vanishing point and turn the words and the palette.",
  "groups": [
    {"name": "Pipe", "params": [
      {"id": "off", "label": "Vanishing point off centre", "min": 0, "max": 0.55, "step": 0.005, "default": 0.34},
      {"id": "offspin", "kind": "rate", "label": "It wanders round (cycles per beat; full is a lap every 8 bars)", "min": -0.032, "max": 0.032, "step": 0.002, "default": 0.008},
      {"id": "rings", "label": "Rings per turn of scale (more means thinner rings, more of them)", "min": 1.8, "max": 5, "step": 0.05, "default": 3.6},
      {"id": "reps", "label": "Times the word goes round (capped so Mirror never squeezes past 4)", "min": 1, "max": 4, "step": 1, "default": 3},
      {"id": "height", "label": "How much of a ring the word fills", "min": 0.55, "max": 1, "step": 0.01, "default": 0.8},
      {"id": "zoom", "kind": "rate", "label": "Travel inward (cycles per beat; full is a ring a bar)", "min": -0.25, "max": 0.25, "step": 0.005, "default": 0.0625},
      {"id": "lurch", "label": "Lurch down the pipe on every beat (rings per beat, eased from the kick)", "min": 0, "max": 0.375, "step": 0.005, "default": 0.125},
      {"id": "spin", "kind": "rate", "label": "Spin (cycles per beat; full is a turn every 2 bars)", "min": -0.125, "max": 0.125, "step": 0.002, "default": 0.006},
      {"id": "twist", "label": "Twist into a helix (whole rings gained per turn; also how many words cycle)", "min": -3, "max": 3, "step": 1, "default": 0},
      {"id": "counter", "kind": "rate", "label": "Alternate rings creep back (cycles per beat)", "min": -0.064, "max": 0.064, "step": 0.002, "default": 0},
      {"id": "mirror", "kind": "fixed", "label": "Mirror into wedges (1 off; words stay whole, but half come out mirror-image)", "min": 1, "max": 4, "step": 1, "default": 1}
    ]},
    {"name": "Type", "params": [
      {"id": "seam", "label": "Hairline between the rings (pixels)", "min": 0, "max": 2.5, "step": 0.05, "default": 1.2},
      {"id": "weight", "label": "Weight of the outline and bloom", "min": 0, "max": 1.2, "step": 0.05, "default": 0.5},
      {"id": "edge", "label": "Outline round the letters", "min": 0, "max": 1, "step": 0.01, "default": 0},
      {"id": "hectic", "label": "How hard the hit goes wild (streaks, split, bloom)", "min": 0, "max": 0.8, "step": 0.01, "default": 0.45}
    ]},
    {"name": "Effects (the hit brings these in)", "params": [
      {"id": "chroma", "label": "Chromatic split, always on", "min": 0, "max": 0.5, "step": 0.01, "default": 0},
      {"id": "trail", "label": "Streaks down the pipe, always on", "min": 0, "max": 0.6, "step": 0.01, "default": 0},
      {"id": "glow", "label": "Bloom round the type, always on", "min": 0, "max": 0.6, "step": 0.01, "default": 0.1}
    ]},
    {"name": "Light and depth", "params": [
