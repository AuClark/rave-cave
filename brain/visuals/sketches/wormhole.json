    ]},
    {"name": "Colour", "params": [
      {"id": "hue", "label": "Hue (when not two tone)", "min": 0, "max": 1, "step": 0.005, "default": 0},
      {"id": "palette", "energy": 0, "label": "Hues in the palette", "min": 2, "max": 8, "step": 1, "default": 3},
      {"id": "spread", "label": "Hue spread down the pipe", "min": 0, "max": 1, "step": 0.01, "default": 0.22},
      {"id": "sat", "label": "Saturation", "min": 0, "max": 1, "step": 0.01, "default": 0.95},
