    ]},
    {"name": "Look", "params": [
      {"id": "size",     "label": "Size",                         "min": 0.4, "max": 2.5, "step": 0.01, "default": 1},
      {"id": "line",     "label": "Ink line",                     "min": 0,   "max": 3,   "step": 0.01, "default": 1},
      {"id": "bright",   "label": "Brightness",                   "min": 0,   "max": 2,   "step": 0.01, "default": 1}
    ]},
    {"name": "Beat", "params": [
      {"id": "punch",    "label": "Crystal and thumbs on kick",   "min": 0,   "max": 2,   "step": 0.01, "default": 0.7}
    ]}
