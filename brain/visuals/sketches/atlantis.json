      {"id": "open",     "label": "Parted by hand",               "min": 0,   "max": 1,   "step": 0.01, "default": 1},
      {"id": "section",  "label": "Part through the section",     "min": 0,   "max": 1,   "step": 1,    "default": 0}
    ]},
    {"name": "Dolphins", "params": [
      {"id": "dolphins", "label": "Dolphins",                     "min": 0,   "max": 6,   "step": 1,    "default": 4},
      {"id": "thumbs",   "label": "Thumb size",                   "min": 0.5, "max": 2.5, "step": 0.01, "default": 1.2}
    ]},
    {"name": "Atlantis", "params": [
      {"id": "glow",     "label": "Crystal glow",                 "min": 0,   "max": 3,   "step": 0.01, "default": 1},
      {"id": "rays",     "label": "Light rays",                   "min": 0,   "max": 3,   "step": 0.01, "default": 1},
      {"id": "hue",      "label": "Glow hue shift",               "min": -0.5,"max": 0.5, "step": 0.005,"default": 0},
