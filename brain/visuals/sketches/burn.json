{
  "title": "Burning Film",
  "about": "Celluloid catching fire in a projector: amber burn holes spread across dark film stock with a white-hot frontier, embers glowing through, sparks drifting up (after Radiant's Burning Film by Paul Bakaus). Burns over a cycle of beats, or through the song section, so the film burns away over a BUILD; the frontier flares on the kick.",
  "climax": {"cycle": "cycle", "peak": "grow > 0.5 ? 0.85 : 0.0", "lock": "droplock", "what": "the frame all fire"},
  "groups": [
    {"name": "Burn", "params": [
      {"id": "grow",      "label": "Direction (1 spread, 0 die down)", "min": 0, "max": 1, "step": 1,  "default": 1},
      {"id": "cycle",     "label": "Burn cycle (beats)",           "min": 4,   "max": 128, "step": 4,    "default": 32},
      {"id": "section",   "label": "Burn through the section",     "min": 0,   "max": 1,   "step": 1,    "default": 0},
      {"id": "speed",     "label": "Pattern drift",                "min": 0,   "max": 3,   "step": 0.01, "default": 0.5},
      {"id": "scale",     "label": "Burn size",                    "min": 0.3, "max": 3,   "step": 0.01, "default": 1}
    ]},
    {"name": "Fire", "params": [
      {"id": "edge",      "label": "Burning edge",                 "min": 0,   "max": 3,   "step": 0.01, "default": 1},
      {"id": "ember",     "label": "Ember glow",                   "min": 0,   "max": 3,   "step": 0.01, "default": 1},
      {"id": "sparks",    "label": "Sparks",                       "min": 0,   "max": 3,   "step": 0.01, "default": 1}
    ]},
    {"name": "Film", "params": [
      {"id": "sprockets", "label": "Sprocket holes",               "min": 0,   "max": 1.5, "step": 0.01, "default": 1},
      {"id": "run",       "label": "Film run (holes per beat)",    "min": 0,   "max": 4,   "step": 0.25, "default": 0},
      {"id": "grain",     "label": "Grain",                        "min": 0,   "max": 3,   "step": 0.01, "default": 1}
    ]},
    {"name": "Beat", "params": [
      {"id": "punch",     "label": "Edge flares on kick",          "min": 0,   "max": 2,   "step": 0.01, "default": 0.5},
      {"id": "droplock", "label": "Land the climax on the drop", "min": 0, "max": 1, "step": 1, "default": 1}
    ]},
    {"name": "Colour", "params": [
      {"id": "hue",       "label": "Hue shift",                    "min": 0,   "max": 1,   "step": 0.005,"default": 0},
      {"id": "follow",    "label": "Shift by show hue",            "min": 0,   "max": 1,   "step": 1,    "default": 0},
      {"id": "bright",    "label": "Brightness",                   "min": 0,   "max": 2,   "step": 0.01, "default": 1}
    ]},
    {"name": "Quality", "params": [
      {"id": "octaves",   "label": "Octaves (6 = original)",       "min": 2,   "max": 6,   "step": 1,    "default": 5}
    ]}
  ]
}
