{
  "title": "Labyrinth",
  "about": "A first-person walk through a maze that never ends: a step a beat, a turn on the bar, alcoves and dead ends on every side, and Ariadne's thread glowing down the floor round every corner. There is always light ahead -- a lamp just round the next turn that grows as you come up to it and moves on as you take it -- and at the end of every phrase the roof slides open and light pours in, a corner away as ever. Every few bars something waits in the corridor: glowing mushrooms that make the maze trip for a phrase, a lantern, an orb, a door of light, a portcullis that lifts on the kicks, a curtain of threads, a fallen pillar.",
  "groups": [
    {"name": "Walk", "params": [
      {"id": "pace", "kind": "rate", "energy": 1, "label": "Pace (cells per beat; snapped so every turn lands on a bar)", "min": 0.25, "max": 1, "step": 0.25, "default": 0.5},
      {"id": "bars", "energy": -1, "label": "Bars in the shortest straight (turns come every 1-3 of these)", "min": 1, "max": 4, "step": 1, "default": 1},
      {"id": "lurch", "energy": 1, "label": "Lurch: how much of each step lands on the kick", "min": 0, "max": 1, "step": 0.01, "default": 0.55},
      {"id": "bob", "label": "Footfall bob and sway from foot to foot", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
      {"id": "sway", "label": "Glance round (head sways; B adds a flick)", "min": 0, "max": 1, "step": 0.01, "default": 0.3},
      {"id": "fov", "label": "Field of view", "min": 0.75, "max": 1.4, "step": 0.01, "default": 1.0}
    ]},
    {"name": "Maze", "params": [
      {"id": "world", "kind": "fixed", "label": "World (0 hedge maze at dusk, 1 stone labyrinth, 2 neon grid, 3 ink on paper, 4 the mushroom trip)", "min": 0, "max": 4, "step": 1, "default": 1},
      {"id": "branch", "label": "Side openings, alcoves and dead ends", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
      {"id": "height", "label": "Wall height (cells)", "min": 1, "max": 2.4, "step": 0.01, "default": 1.35},
      {"id": "thick", "label": "Wall thickness", "min": 0.08, "max": 0.3, "step": 0.01, "default": 0.15},
      {"id": "tex", "label": "Texture (leaves, stone courses, hatching)", "min": 0, "max": 1, "step": 0.01, "default": 0.85}
    ]},
    {"name": "Hope", "params": [
      {"id": "hope", "label": "The light round the next corner", "min": 0.3, "max": 1.5, "step": 0.01, "default": 1.0},
      {"id": "thread", "label": "Ariadne's thread", "min": 0, "max": 1, "step": 0.01, "default": 0.8},
      {"id": "motes", "label": "Fireflies and motes", "min": 0, "max": 1, "step": 0.01, "default": 0.45},
      {"id": "fog", "label": "Glow of the distance", "min": 0, "max": 1, "step": 0.01, "default": 0.45},
      {"id": "sky", "label": "Roof open all the time", "min": 0, "max": 0.6, "step": 0.01, "default": 0.08},
      {"id": "reveal", "energy": 0, "label": "The roof opens at the end of every (0 never, 1 4 bars, 2 8 bars, 3 16 bars)", "min": 0, "max": 3, "step": 1, "default": 2}
    ]},
    {"name": "Encounters", "params": [
      {"id": "every", "energy": 1, "label": "Something in the corridor every (0 never, 1 2 bars, 2 4 bars, 3 8 bars)", "min": 0, "max": 3, "step": 1, "default": 2},
      {"id": "kinds", "energy": 0, "label": "What (0 anything, 1 mushrooms, 2 lights: lantern, orb, door, 3 obstacles: gate, threads, pillar, 4 lights and obstacles)", "min": 0, "max": 4, "step": 1, "default": 0},
      {"id": "trip", "label": "How hard the mushrooms trip you", "min": 0, "max": 1, "step": 0.01, "default": 0.7}
    ]},
    {"name": "Render", "params": [
