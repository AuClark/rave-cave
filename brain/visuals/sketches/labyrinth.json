      {"id": "sat", "label": "Saturation of the light", "min": 0, "max": 1, "step": 0.01, "default": 0.85},
      {"id": "bright", "label": "Brightness", "min": 0.6, "max": 1.6, "step": 0.01, "default": 1.0},
      {"id": "vign", "label": "Vignette", "min": 0, "max": 0.6, "step": 0.01, "default": 0.3}
    ]}
