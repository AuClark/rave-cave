      {"id": "vibrancy", "label": "Colour vibrancy",            "min": 0,   "max": 2,   "step": 0.01, "default": 0.8},
      {"id": "speed",    "label": "Time (per beat)",            "min": 0,   "max": 2,   "step": 0.01, "default": 0.476},
      {"id": "scale",    "label": "Zoom",                       "min": 0.3, "max": 3,   "step": 0.01, "default": 1}
    ]},
    {"name": "Beat", "params": [
      {"id": "punch",    "label": "Blooms flare on kick",       "min": 0,   "max": 2,   "step": 0.01, "default": 0.5},
      {"id": "energy",   "label": "Heat follows energy",        "min": 0,   "max": 2,   "step": 0.01, "default": 0}
    ]},
    {"name": "Colour", "params": [
      {"id": "hue",      "label": "Hue shift",                  "min": 0,   "max": 1,   "step": 0.005,"default": 0},
      {"id": "follow",   "label": "Shift by show hue",          "min": 0,   "max": 1,   "step": 1,    "default": 0},
      {"id": "bright",   "label": "Brightness",                 "min": 0,   "max": 2,   "step": 0.01, "default": 1},
      {"id": "vignette", "label": "Vignette",                   "min": 0,   "max": 1,   "step": 0.01, "default": 1}
    ]},
    {"name": "Quality", "params": [
      {"id": "octaves",  "label": "Octaves (6 = original)",     "min": 2,   "max": 6,   "step": 1,    "default": 4},
      {"id": "chroma",   "label": "Chromatic (full 3-channel)", "min": 0,   "max": 1,   "step": 1,    "default": 0}
    ]}
  ]
