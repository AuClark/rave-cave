      {"id": "swing",      "label": "Swing toward mandala",        "min": 0,   "max": 1,   "step": 0.01, "default": 0},
      {"id": "cycle",      "label": "Swing cycle (beats)",         "min": 4,   "max": 128, "step": 4,    "default": 32},
      {"id": "morph",      "label": "Build through the section",   "min": 0,   "max": 1,   "step": 0.01, "default": 0},
      {"id": "complexity", "label": "Complexity",                  "min": 0.3, "max": 2,   "step": 0.01, "default": 1},
      {"id": "size",       "label": "Size",                        "min": 0.3, "max": 2.5, "step": 0.01, "default": 1}
    ]},
    {"name": "Motion", "params": [
      {"id": "speed",      "label": "Time (per beat)",             "min": 0,   "max": 2,   "step": 0.01, "default": 0.476},
      {"id": "rot",        "label": "Layer rotation",              "min": -3,  "max": 3,   "step": 0.01, "default": 0.3},
