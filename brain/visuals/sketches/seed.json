{
  "title": "Seed",
  "about": "Neon branching growths over glowing flower dots, after Vincent Houze's video for Max Cooper's Seed. Fractal trees sway in time and grow a level at a time through the section.",
  "groups": [
    {"name": "Trees", "params": [
      {"id": "trees",   "label": "Trees",                "min": 1,    "max": 8,    "step": 1,     "default": 3},
