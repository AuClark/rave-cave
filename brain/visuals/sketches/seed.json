      {"id": "angle",   "label": "Branch angle",         "min": 0.1,  "max": 1.4,  "step": 0.01,  "default": 0.5},
      {"id": "ratio",   "label": "Branch shrink",        "min": 0.5,  "max": 0.85, "step": 0.005, "default": 0.72},
      {"id": "sway",    "label": "Sway",                 "min": 0,    "max": 1,    "step": 0.01,  "default": 0.5},
      {"id": "grow",    "label": "Grow through section", "min": 0,    "max": 1,    "step": 0.01,  "default": 0.5}
    ]},
    {"name": "Look", "params": [
      {"id": "width",   "label": "Width",                "min": 0.0005,"max": 0.01, "step": 0.0005,"default": 0.002},
      {"id": "glow",    "label": "Glow",                 "min": 0,    "max": 1,    "step": 0.01,  "default": 0.5},
      {"id": "blossom", "label": "Blossoms at the tips", "min": 0,    "max": 1,    "step": 0.01,  "default": 0.3},
      {"id": "ground",  "label": "Ground flowers",       "min": 0,    "max": 1,    "step": 0.01,  "default": 0.5},
      {"id": "beat",    "label": "Beat punch",           "min": 0,    "max": 1,    "step": 0.01,  "default": 0.5}
    ]},
    {"name": "Colour", "params": [
      {"id": "hue",     "label": "Hue",                  "min": 0,    "max": 1,    "step": 0.005, "default": 0.58},
      {"id": "spread",  "label": "Hue spread (trunk to tips)", "min": 0, "max": 1, "step": 0.01,  "default": 0.6},
      {"id": "sat",     "label": "Saturation",           "min": 0,    "max": 1,    "step": 0.01,  "default": 0.8},
      {"id": "follow",  "label": "Follow show hue",      "min": 0,    "max": 1,    "step": 1,     "default": 0}
    ]}
  ]
