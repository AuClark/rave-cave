vec3 content(vec2 uv) {
  float t = u_beat;
  float k = kick() * p_beat;
  float bar = floor(t / 4.0), bb = mod(t, 4.0);
  float n = max(1.0, min(p_count, msgCount() - p_first));
  float m = p_first + (p_random > 0.5 ? floor(hash(vec2(bar, 2.1)) * n) : mod(bar, n));
  bool drop = abs(u_scene - 7.0) < 0.5, build = abs(u_scene - 4.0) < 0.5 || abs(u_scene - 6.0) < 0.5;

  // Is the word showing right now?
  float on = 0.0;
  if (p_mode < 0.5) on = step(bb, p_hold);
  else if (p_mode < 1.5) { on = step(u_frac, p_hold); m = p_first + mod(floor(t), n); }
  else if (p_mode < 2.5) on = 1.0;
  else {
    on = drop ? 1.0 : 0.0;
    if (build) on = step(hash(vec2(floor(t * 4.0), 5.3)), u_sp * 0.6);
  }

  // Fit the word: height Size, never wider than 92% of the surface.
  float len = msgLen(m);
  float wpx = len * 6.0 - 1.0;
  float s = min(p_size / 7.0, 0.92 * u_aspect / wpx);
  vec2 P = (uv - 0.5) * vec2(u_aspect, 1.0);
  float jf = floor(u_time * 24.0);
  P += p_jitter * 0.012 * (vec2(hash(vec2(jf, 1.0)), hash(vec2(jf, 2.0))) - 0.5) * (0.4 + k);
  vec2 q = (P + vec2(wpx, 7.0) * s * 0.5) / s;
  float px = u_px / s;
  float sh = p_glitch * (0.6 + 2.0 * k) * 0.8;          // RGB split, in font pixels
  vec3 cov = p_glitch > 0.01
    ? vec3(textCov(q + vec2(sh, 0.0), m, px), textCov(q, m, px), textCov(q - vec2(sh, 0.0), m, px))
    : vec3(textCov(q, m, px));
  cov *= on;

  // Background: black, a flash on the word, or the bland broadcast in Reveal mode.
  vec3 ink = p_sat < 0.01 ? vec3(1.0) : hsv(p_hue + (p_follow > 0.5 ? u_hue : 0.0), p_sat, 1.0);
  vec3 bg = vec3(p_bg * on * (0.25 + 0.75 * k));
  if (p_mode > 2.5 && on < 0.5) {
    float g = 0.5 + 0.5 * sin(uv.x * 3.0 + t * 0.2) * cos(uv.y * 2.0 - t * 0.13);
    bg = mix(vec3(0.25, 0.45, 0.7), vec3(0.95, 0.7, 0.55), g) * 0.55;
  }
  vec3 col = p_invert > 0.5 && on > 0.5 ? mix(vec3(0.95), vec3(0.0), cov) : bg + (1.0 - bg) * ink * cov;
  col += (hash(uv * 731.0 + fract(u_time) * 17.0) - 0.5) * p_grain * 0.25;
  col *= 1.0 - p_grain * 0.25 * (0.5 + 0.5 * sin(uv.y * 900.0));
  return clamp(col, 0.0, 1.0);
}
