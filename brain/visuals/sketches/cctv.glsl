#define CH_4 25.0
#define CH_5 26.0
#define CH_6 27.0
#define CH_7 28.0
#define CH_8 29.0
#define CH_9 30.0
vec2 glyph(float c) {
  if (c < 0.5) return vec2(0.0);
  if (c < 1.5) return vec2(1033774.0, 17969.0);   // A
  if (c < 2.5) return vec2(509487.0, 15921.0);   // B
  if (c < 3.5) return vec2(34350.0, 14881.0);   // C
  if (c < 4.5) return vec2(575023.0, 15921.0);   // D
  if (c < 5.5) return vec2(492607.0, 31777.0);   // E
  if (c < 6.5) return vec2(492607.0, 1057.0);   // F
  if (c < 7.5) return vec2(951854.0, 31281.0);   // G
  if (c < 8.5) return vec2(1033777.0, 17969.0);   // H
  if (c < 9.5) return vec2(135310.0, 14468.0);   // I
  if (c < 10.5) return vec2(270620.0, 6440.0);   // J
  if (c < 11.5) return vec2(103729.0, 17701.0);   // K
  if (c < 12.5) return vec2(33825.0, 31777.0);   // L
