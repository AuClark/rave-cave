// CCTV: a surveillance camera view. Figures walk through a night scene (night vision,
// thermal or grey); a targeting box jumps to a new one every few beats with a label;
// REC blinks on the beat, a camera number and a running timestamp sit in the corners;
// scanlines, a rolling bar, grain and a line glitch on the kick.
// Params are p_* uniforms; ranges and defaults are in cctv.json.
//
// @messages: REC|CAM|SUBJECT IDENTIFIED|TRACKING|MOTION DETECTED|MATCH 98.7|LIVE|RESTRICTED AREA|0123456789:
uniform float p_palette, p_people, p_walk, p_boxes, p_every, p_label, p_rec, p_stamp, p_cam,
              p_grain, p_scan, p_roll, p_vignette, p_glitch, p_zoom, p_beat;

#define TAU 6.2831853

// <text>
// Generated by brain/visuals/tools/glsltext.py from the @messages line. Don't edit by hand.
