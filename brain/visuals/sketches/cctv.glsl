  if (c < 15.5) return vec2(575022.0, 14897.0);   // O
  if (c < 16.5) return vec2(509487.0, 17701.0);   // R
  if (c < 17.5) return vec2(459838.0, 15888.0);   // S
  if (c < 18.5) return vec2(135327.0, 4228.0);   // T
  if (c < 19.5) return vec2(575025.0, 14897.0);   // U
  if (c < 20.5) return vec2(575025.0, 4433.0);   // V
  if (c < 21.5) return vec2(714286.0, 14899.0);   // 0
  if (c < 22.5) return vec2(135364.0, 14468.0);   // 1
  if (c < 23.5) return vec2(279086.0, 31812.0);   // 2
  if (c < 24.5) return vec2(266527.0, 14896.0);   // 3
  if (c < 25.5) return vec2(305544.0, 8479.0);   // 4
  if (c < 26.5) return vec2(539711.0, 14896.0);   // 5
