{
  "title": "Pendulum Wave",
  "about": "A row of pendulums, each swinging a little faster than the last, drifting through snakes and braids and falling back into a line at the end of every cycle (after Radiant's Pendulum Wave by Paul Bakaus). The cycle is in beats, so the line comes back on the phrase; the bobs flash and ripple on the beat.",
  "groups": [
    {"name": "Pendulums", "params": [
      {"id": "count",  "label": "Pendulums",                "min": 3,    "max": 40,   "step": 1,     "default": 20},
      {"id": "cycle",  "label": "Cycle (beats, back in line)", "min": 16, "max": 512,  "step": 16,    "default": 128},
      {"id": "base",   "label": "Swings per cycle (longest)", "min": 4,   "max": 60,   "step": 1,     "default": 30},
      {"id": "amp",    "label": "Swing (degrees)",          "min": 5,    "max": 80,   "step": 1,     "default": 35},
      {"id": "trail",  "label": "Trail (beats)",            "min": 0,    "max": 6,    "step": 0.05,  "default": 1.75}
    ]},
    {"name": "Look", "params": [
      {"id": "size",   "label": "Size (bobs and lines)",    "min": 0.5,  "max": 4,    "step": 0.05,  "default": 1.5},
      {"id": "curve",  "label": "Curve through the bobs",   "min": 0,    "max": 4,    "step": 0.01,  "default": 1},
      {"id": "frame",  "label": "Pivot bar and guides",     "min": 0,    "max": 4,    "step": 0.01,  "default": 1}
    ]},
    {"name": "Beat", "params": [
      {"id": "punch",  "label": "Bobs flash on kick",       "min": 0,    "max": 2,    "step": 0.01,  "default": 0.5},
      {"id": "wave",   "label": "Ripple on each beat",      "min": 0,    "max": 2,    "step": 0.01,  "default": 0}
    ]},
    {"name": "Colour", "params": [
      {"id": "tint",   "label": "Original colours → tint",  "min": 0,    "max": 1,    "step": 0.01,  "default": 0},
      {"id": "hue",    "label": "Tint hue",                 "min": 0,    "max": 1,    "step": 0.005, "default": 0.07},
      {"id": "spread", "label": "Hue spread (left → right)", "min": -0.5, "max": 0.5,  "step": 0.005, "default": 0.05},
      {"id": "sat",    "label": "Tint saturation",          "min": 0,    "max": 1,    "step": 0.01,  "default": 0.5},
      {"id": "bright", "label": "Brightness",               "min": 0,    "max": 2,    "step": 0.01,  "default": 1},
      {"id": "bg",     "label": "Background",               "min": 0,    "max": 0.2,  "step": 0.005, "default": 0.04},
      {"id": "follow", "label": "Follow show hue",          "min": 0,    "max": 1,    "step": 1,     "default": 0}
    ]}
  ]
}
