{
  "title": "Pipes",
  "about": "White square pipes running through a grey tiled room, after Graphset's video for Max Cooper's Echoes Reality. Two layers drift for depth; cells re-roll every few bars.",
  "groups": [
    {"name": "Pipes", "params": [
      {"id": "scale",   "label": "Cells across height",  "min": 2,     "max": 30,   "step": 0.5,   "default": 7},
      {"id": "width",   "label": "Pipe width",           "min": 0.002, "max": 0.05, "step": 0.001, "default": 0.012},
      {"id": "density", "label": "Density",              "min": 0,     "max": 1,    "step": 0.01,  "default": 0.6},
      {"id": "square",  "label": "Round → square corners", "min": 0,   "max": 1,    "step": 0.01,  "default": 1},
      {"id": "layers",  "label": "Layers",               "min": 1,     "max": 2,    "step": 1,     "default": 2},
      {"id": "beat",    "label": "Beat punch",           "min": 0,     "max": 1,    "step": 0.01,  "default": 0.5}
    ]},
    {"name": "Motion", "params": [
      {"id": "drift",   "label": "Drift (widths per 32 beats)", "min": -2, "max": 2, "step": 0.01, "default": 0.5},
      {"id": "reroll",  "label": "Re-roll every (bars)", "min": 1,     "max": 16,   "step": 1,     "default": 2}
    ]},
    {"name": "Room", "params": [
      {"id": "shadow",  "label": "Shadows",              "min": 0,     "max": 1,    "step": 0.01,  "default": 0.7},
      {"id": "room",    "label": "Tiles and floor lines","min": 0,     "max": 1,    "step": 0.01,  "default": 0.8},
      {"id": "hue",     "label": "Pipe tint",            "min": 0,     "max": 1,    "step": 0.005, "default": 0.6},
      {"id": "sat",     "label": "Tint amount",          "min": 0,     "max": 1,    "step": 0.01,  "default": 0}
    ]}
  ]
}
