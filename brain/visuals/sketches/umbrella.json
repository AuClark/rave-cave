      {"id": "size",   "label": "Drop size",                   "min": 0.4, "max": 2.5, "step": 0.01, "default": 1},
      {"id": "life",   "label": "Drop life (beats)",           "min": 2,   "max": 32,  "step": 1,    "default": 8},
      {"id": "slide",  "label": "Slide down the dome",         "min": 0,   "max": 4,   "step": 0.01, "default": 1.5},
      {"id": "trail",  "label": "Trails",                      "min": 0,   "max": 2,   "step": 0.01, "default": 1},
      {"id": "micro",  "label": "Micro-droplets",              "min": 0,   "max": 1,   "step": 0.01, "default": 0.45},
      {"id": "onbeat", "label": "Impacts on the beat",         "min": 0,   "max": 1,   "step": 1,    "default": 1}
    ]},
    {"name": "Look", "params": [
