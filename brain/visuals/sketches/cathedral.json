{
  "title": "Cathedral",
  "about": "A kaleidoscopic fractal you fly through and never reach the end of. Space is mirrored into wedges around the axis of travel and folded back into itself, which builds arches inside arches inside arches at every scale, with a nave cut down the middle to fly along. It is raymarched, so the depth is real and the colour comes out of the geometry. It is also the only sketch that marches, so it costs several times what a flat sketch does: if the projector struggles, drop Detail first (it is the lever that pays), then Depth; Steps barely changes the cost. Reactivity is the standard three slots, see docs/reactive.md.",
  "groups": [
    {"name": "Structure", "params": [
      {"id": "sides",  "label": "Kaleidoscope wedges",           "min": 2,   "max": 12,  "step": 1,     "default": 6},
      {"id": "detail", "kind": "quality", "label": "Fold passes (detail)",          "min": 1,   "max": 8,   "step": 1,     "default": 5},
      {"id": "scale",  "label": "Fold scale",                    "min": 1.3, "max": 2.4, "step": 0.01,  "default": 1.75},
      {"id": "form",   "label": "Form (chunks to solid crystal)", "min": 0.2, "max": 1.6, "step": 0.01,  "default": 1.08},
      {"id": "fold",   "label": "Fold angle (plain to intricate)","min": 0,   "max": 1,   "step": 0.005, "default": 0.75},
      {"id": "bore",   "label": "Nave width",                    "min": 0.2, "max": 2.5, "step": 0.01,  "default": 0.8}
    ]},
    {"name": "Flight", "params": [
      {"id": "bay", "energy": -1,    "label": "Beats per bay",                 "min": 0.25,"max": 16,  "step": 0.25,  "default": 2},
      {"id": "twist",  "label": "Twist",                         "min": 0,   "max": 0.6, "step": 0.005, "default": 0.08},
      {"id": "spin", "kind": "rate",   "label": "Roll (cycles per beat)",        "min": -0.25,"max": 0.25,"step": 0.005,"default": 0.01},
      {"id": "sway",   "label": "Sway off the axis",             "min": 0,   "max": 1,   "step": 0.01,  "default": 0.1}
    ]},
    {"name": "Render", "params": [
      {"id": "steps", "kind": "quality",  "label": "Steps (lower is faster)",       "min": 24,  "max": 96,  "step": 4,     "default": 64},
      {"id": "far",    "label": "Depth",                         "min": 4,   "max": 20,  "step": 0.5,   "default": 9},
      {"id": "fog",    "label": "Fog",                           "min": 0,   "max": 0.6, "step": 0.005, "default": 0.22},
      {"id": "glow",   "label": "Glow in the arches",            "min": 0,   "max": 1.5, "step": 0.01,  "default": 0.45},
      {"id": "shade",  "label": "Shading",                       "min": 0,   "max": 1,   "step": 0.01,  "default": 0.95}
    ]},
    {"name": "Reactivity", "params": [
      {"id": "aband",  "label": "A Hit · band (0 off, 1 kick, 2 chords, 3 hats, 4 all, 5 energy)", "min": 0, "max": 5, "step": 1, "default": 1},
      {"id": "aloop",  "label": "A Hit · loop (0 ½beat, 1 beat, 2 bar, 3 2bar, 4 4bar, 5 8bar, 6 16bar)", "min": 0, "max": 6, "step": 1, "default": 1},
      {"id": "ashape", "label": "A Hit · shape (0 follow, 1 punch, 2 ramp, 3 swell, 4 gate, 5 step)", "min": 0, "max": 5, "step": 1, "default": 1},
      {"id": "aamt",   "label": "A Hit · amount",                "min": 0, "max": 1, "step": 0.01, "default": 0.7},
      {"id": "bband",  "label": "B Move · band",                 "min": 0, "max": 5, "step": 1, "default": 3},
      {"id": "bloop",  "label": "B Move · loop",                 "min": 0, "max": 6, "step": 1, "default": 0},
      {"id": "bshape", "label": "B Move · shape",                "min": 0, "max": 5, "step": 1, "default": 0},
      {"id": "bamt",   "label": "B Move · amount",               "min": 0, "max": 1, "step": 0.01, "default": 0.35},
      {"id": "cband",  "label": "C Change · band",               "min": 0, "max": 5, "step": 1, "default": 2},
      {"id": "cloop",  "label": "C Change · loop",               "min": 0, "max": 6, "step": 1, "default": 5},
      {"id": "cshape", "label": "C Change · shape",              "min": 0, "max": 5, "step": 1, "default": 3},
      {"id": "camt",   "label": "C Change · amount",             "min": 0, "max": 1, "step": 0.01, "default": 0.6}
    ]},
    {"name": "Colour", "params": [
      {"id": "hue",    "label": "Hue",                           "min": 0, "max": 1, "step": 0.005, "default": 0.58},
      {"id": "spread", "label": "Hue spread across the stone",   "min": 0, "max": 1, "step": 0.01,  "default": 0.28},
      {"id": "sat",    "label": "Saturation",                    "min": 0, "max": 1, "step": 0.01,  "default": 0.85},
      {"id": "follow", "label": "Follow show hue",               "min": 0, "max": 1, "step": 1,     "default": 0}
    ]}
  ]
}
