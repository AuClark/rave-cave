// Hypnotoad: ALL GLORY TO THE HYPNOTOAD. Front-on and symmetrical, which is how he is seen and
// the most hypnotic way to put anything on a wall.
//
// He keeps his own colours whatever the show's hue is doing: olive and cream, and two bulging
// yellow eyeballs. Tint overrules that. Everything behind him -- hypno rings radiating from his
// stare, and sacred geometry over them -- takes the hue, on a small quantised palette.
//
// The eyes are the whole point, built to the show's animation: plain yellow eyeballs, and in each
// a big soft black pupil snapping between a slit, a bean, an arch and a four-lobed star, the two
// eyes out of step, ringed by a glowing border that is offset contours of the pupil itself. The
// shapes step on the beat grid; the kick pops the pupil and makes the eyeballs glow.
//
// Drivers (docs/reactive.md): A Hit -> the bob and squash, the pupil throb and the eye glow;
// B Move -> the geometry turning, the rings crawling and the pupil outline wobbling; C Change -> the palette and
// how much sacred line-work is on top.
// Params are p_* uniforms; ranges and defaults are in hypnotoad.json.
//
// @messages: ALL GLORY TO|THE HYPNOTOAD
uniform float p_size, p_bob, p_blink, p_patches, p_tint, p_collar, p_ink, p_halo,
              p_eyesize, p_pupil, p_pstep, p_glide, p_border, p_irisc, p_glory,
              p_mode, p_scale, p_detail, p_width, p_spin,
              p_bands, p_wave, p_bandspin, p_glow,
              p_aband, p_aloop, p_ashape, p_aamt,
              p_bband, p_bloop, p_bshape, p_bamt,
              p_cband, p_cloop, p_cshape, p_camt,
              p_hue, p_palette, p_sat, p_follow;

// <text>
// Generated by brain/visuals/tools/glsltext.py from the @messages line. Don't edit by hand.
#define CH_A 1.0
#define CH_D 2.0
#define CH_E 3.0
#define CH_G 4.0
#define CH_H 5.0
#define CH_L 6.0
#define CH_N 7.0
#define CH_O 8.0
#define CH_P 9.0
#define CH_R 10.0
#define CH_T 11.0
#define CH_Y 12.0
vec2 glyph(float c) {
  if (c < 0.5) return vec2(0.0);
  if (c < 1.5) return vec2(1033774.0, 17969.0);   // A
  if (c < 2.5) return vec2(575023.0, 15921.0);   // D
  if (c < 3.5) return vec2(492607.0, 31777.0);   // E
  if (c < 4.5) return vec2(951854.0, 31281.0);   // G
  if (c < 5.5) return vec2(1033777.0, 17969.0);   // H
  if (c < 6.5) return vec2(33825.0, 31777.0);   // L
  if (c < 7.5) return vec2(708145.0, 17977.0);   // N
  if (c < 8.5) return vec2(575022.0, 14897.0);   // O
  if (c < 9.5) return vec2(509487.0, 1057.0);   // P
  if (c < 10.5) return vec2(509487.0, 17701.0);   // R
  if (c < 11.5) return vec2(135327.0, 4228.0);   // T
  if (c < 12.5) return vec2(141873.0, 4228.0);   // Y
  return vec2(0.0);
}
float msgChunk(float m, float k) {             // three characters per float, base 64
  if (m < 0.5) { if (k < 0.5) return 24961.0; if (k < 1.5) return 24832.0; if (k < 2.5) return 49800.0; if (k < 3.5) return 33472.0; return 0.0; }   // ALL GLORY TO
  if (m < 1.5) { if (k < 0.5) return 12619.0; if (k < 1.5) return 49472.0; if (k < 2.5) return 33225.0; if (k < 3.5) return 4619.0; if (k < 4.5) return 2.0; return 0.0; }   // THE HYPNOTOAD
  return 0.0;
}
float msgCount() { return 2.0; }
float msgLen(float m) {
  if (m < 0.5) return 12.0;
  if (m < 1.5) return 13.0;
  return 0.0;
}
float msgChar(float m, float i) {
  float v = msgChunk(m, floor(i / 3.0)), j = mod(i, 3.0);
  return mod(floor(v / (j < 0.5 ? 1.0 : j < 1.5 ? 64.0 : 4096.0)), 64.0);
}
float glyphBit(vec2 g, vec2 cell) {                 // cell: column 0..4, row 0..6 from the top
  if (cell.x < 0.0 || cell.x > 4.0 || cell.y < 0.0 || cell.y > 6.0) return 0.0;
  float v = cell.y < 3.5 ? g.x : g.y, r = cell.y < 3.5 ? cell.y : cell.y - 4.0;
  float row = mod(floor(v / (r < 0.5 ? 1.0 : r < 1.5 ? 32.0 : r < 2.5 ? 1024.0 : 32768.0)), 32.0);
  float x = cell.x;
  return mod(floor(row / (x < 0.5 ? 1.0 : x < 1.5 ? 2.0 : x < 2.5 ? 4.0 : x < 3.5 ? 8.0 : 16.0)), 2.0);
}
float charCov(vec2 q, float c, float px) {
  if (c < 0.5 || q.x < -1.0 || q.x > 6.0 || q.y < -1.0 || q.y > 8.0) return 0.0;
  vec2 g = glyph(c);
  vec2 s = q - 0.5, i0 = floor(s), fr = fract(s);
  float v = mix(mix(glyphBit(g, i0), glyphBit(g, i0 + vec2(1.0, 0.0)), fr.x),
                mix(glyphBit(g, i0 + vec2(0.0, 1.0)), glyphBit(g, i0 + vec2(1.0, 1.0)), fr.x), fr.y);
  float w = max(px, 0.02);
  return smoothstep(0.4 - w, 0.4 + w, v);             // below 0.5: bolder, diagonals join
}
float textCov(vec2 q, float m, float px) {
  float ci = floor(q.x / 6.0);
  if (ci < 0.0 || ci >= msgLen(m)) return 0.0;
  return charCov(q - vec2(ci * 6.0, 0.0), msgChar(m, ci), px);
}
float letterIndex(float c) {
  if (abs(c - 1.0) < 0.5) return 0.0;
  if (abs(c - 2.0) < 0.5) return 3.0;
  if (abs(c - 3.0) < 0.5) return 4.0;
  if (abs(c - 4.0) < 0.5) return 6.0;
  if (abs(c - 5.0) < 0.5) return 7.0;
  if (abs(c - 6.0) < 0.5) return 11.0;
  if (abs(c - 7.0) < 0.5) return 13.0;
  if (abs(c - 8.0) < 0.5) return 14.0;
  if (abs(c - 9.0) < 0.5) return 15.0;
  if (abs(c - 10.0) < 0.5) return 17.0;
  if (abs(c - 11.0) < 0.5) return 19.0;
  if (abs(c - 12.0) < 0.5) return 24.0;
  return -1.0;
