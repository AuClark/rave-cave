{
  "title": "Sacred geometry",
  "about": "Gold line geometry: 0 Sierpinski zoom, 1 Flower of Life, 2 Metatron's Cube, 3 golden spiral, 4 pyramid tunnel. Beat-locked zoom, spin and a pulse that runs through the levels.",
  "groups": [
    {"name": "Form", "params": [
      {"id": "mode",   "label": "Mode (0 Sierpinski, 1 Flower, 2 Metatron, 3 Spiral, 4 Tunnel)", "min": 0, "max": 4, "step": 1, "default": 0},
      {"id": "scale",  "label": "Scale",                 "min": 0.2,   "max": 3,    "step": 0.01,  "default": 1},
      {"id": "detail", "label": "Detail (levels / rings / arms)", "min": 1, "max": 10, "step": 1, "default": 7},
      {"id": "fill",   "label": "Fill (Metatron lines, counter-spiral, tunnel twist)", "min": 0, "max": 1, "step": 0.01, "default": 0.3}
    ]},
    {"name": "Motion", "params": [
      {"id": "zoom", "kind": "rate",   "label": "Zoom (cycles/beat)",    "min": -1,    "max": 1,    "step": 0.005, "default": 0.125},
      {"id": "spin",   "label": "Spin",                  "min": -2,    "max": 2,    "step": 0.01,  "default": 0.05},
      {"id": "pulse",  "label": "Pulse through levels",  "min": 0,     "max": 1,    "step": 0.01,  "default": 0.5},
      {"id": "beat",   "label": "Beat punch",            "min": 0,     "max": 1,    "step": 0.01,  "default": 0.5}
    ]},
    {"name": "Line", "params": [
      {"id": "width",  "label": "Width",                 "min": 0.0005,"max": 0.02, "step": 0.0005,"default": 0.002},
      {"id": "glow",   "label": "Glow",                  "min": 0,     "max": 1,    "step": 0.01,  "default": 0.35}
    ]},
    {"name": "Colour", "params": [
      {"id": "hue",    "label": "Hue",                   "min": 0,     "max": 1,    "step": 0.005, "default": 0.11},
      {"id": "spread", "label": "Hue spread by level",   "min": 0,     "max": 1,    "step": 0.01,  "default": 0.1},
      {"id": "sat",    "label": "Saturation",            "min": 0,     "max": 1,    "step": 0.01,  "default": 0.8},
      {"id": "follow", "label": "Follow show hue",       "min": 0,     "max": 1,    "step": 1,     "default": 0}
    ]}
  ]
}
