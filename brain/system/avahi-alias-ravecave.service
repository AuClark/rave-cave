[Unit]
Description=Answer the old name ravecave.local (transition after the Sektor5 rename)
After=avahi-daemon.service network-online.target
Wants=network-online.target
Requires=avahi-daemon.service

[Service]
ExecStart=/bin/sh -c 'exec avahi-publish -a -R ravecave.local "$(ip -4 -o addr show wlan0 | awk "{print \$4}" | cut -d/ -f1)"'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
