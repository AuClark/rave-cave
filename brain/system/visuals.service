[Unit]
Description=Sektor5 generative visuals (control page + live params on :8110)
After=showbrain.service network-online.target

[Service]
User=ravesvc
Group=rave
UMask=0002
WorkingDirectory=/srv/rave/visuals
ExecStart=/usr/bin/python3 -u visuals.py 8110
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
