# Copy to .env (git-ignored) and fill in. Site-specific values live here, never in git.

# Wi-Fi the rig joins (used by brain/provision/make_cloudinit.py and fixtures/tubes/scripts/wled_wifi_serial.py)
RAVE_WIFI_SSID=
RAVE_WIFI_PASSWORD=
RAVE_WIFI_COUNTRY=AU

# Hosts (defaults shown; only set these if a device isn't reachable by its .local name)
RAVE_BRAIN_HOST=ravecave.local
RAVE_BOX_HOST=rave-box.local
RAVE_TUBE1_HOST=rave-tube-1.local
RAVE_TUBE2_HOST=rave-tube-2.local
